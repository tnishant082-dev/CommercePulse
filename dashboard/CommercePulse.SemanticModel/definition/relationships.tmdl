relationship FactSales_DimDate
	fromColumn: FactSales.DateKey
	toColumn: DimDate.DateKey

relationship FactSales_DimCustomer
	fromColumn: FactSales.CustomerKey
	toColumn: DimCustomer.CustomerKey

relationship FactSales_DimProduct
	fromColumn: FactSales.ProductKey
	toColumn: DimProduct.ProductKey

relationship FactSales_DimCountry
	fromColumn: FactSales.CountryKey
	toColumn: DimCountry.CountryKey

relationship FactReturns_DimDate
	fromColumn: FactReturns.DateKey
	toColumn: DimDate.DateKey

relationship FactReturns_DimProduct
	fromColumn: FactReturns.ProductKey
	toColumn: DimProduct.ProductKey
